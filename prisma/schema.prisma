// DRAY-WORLD LOGISTICS — TMS schema.
//
// Conventions
// - Money:      Decimal(12,2). Never Float.
// - Dates:      appointment dates are DATE (no time zone, no UTC shifting).
//               appointment times are facility-local wall-clock text ("08:00", "08:00-12:00").
//               audit/system timestamps are timestamptz.
// - Deletion:   business records are archived / cancelled, never hard-deleted.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  OPERATIONS
  DISPATCHER
  ACCOUNTING
  READ_ONLY
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum LoadType {
  DRAYAGE
  OTR
}

// Kept deliberately short: Created (booked, not started) → In progress (dispatched,
// on the road or awaiting paperwork) → Completed (done and paperwork in).
enum LoadStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
}

enum ShipmentDirection {
  IMPORT
  EXPORT
  OTHER
}

enum WeightUnit {
  LB
  KG
}

enum Currency {
  USD
  CAD
}

enum DocumentType {
  CARRIER_RATE_CONFIRMATION
  SHIPPER_RATE_CONFIRMATION
  BOL
  POD
  COD
  INVOICE
  RECEIPT
  LUMPER_RECEIPT
  SCALE_TICKET
  GATE_TICKET
  CUSTOMS_DOCUMENT
  OTHER
}

enum DocumentSource {
  GENERATED
  UPLOADED
}

enum QuoteRequestKind {
  QUOTE
  CALLBACK
}

// Where a lead came from: the website quote form, or entered by staff (phone, email, walk-in).
enum LeadSource {
  WEBSITE
  STAFF
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

// ─────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique // stored lower-cased
  name         String
  passwordHash String
  role         UserRole  @default(OPERATIONS)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
}

// The primary key is the SHA-256 hash of the opaque session token.
// The raw token only ever exists in the user's HTTP-only cookie.
model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Company profile (singleton row, id = "company")
// ─────────────────────────────────────────────────────────────

model CompanySettings {
  id                      String   @id @default("company")
  legalName               String
  displayName             String
  addressLine1            String
  addressLine2            String?
  city                    String
  stateProvince           String
  postalCode              String
  country                 String
  phone                   String?
  operationsPhone         String?
  email                   String?
  operationsEmail         String?
  website                 String?
  mcNumber                String?
  dotNumber               String?
  // Standard Carrier Alpha Code and D-U-N-S number.
  scacCode                String?
  dunsNumber              String?
  businessNumber          String?
  logoStorageKey          String?
  paymentInstructions     String?
  carrierTerms            String?
  shipperTerms            String?
  bolInstructions         String?
  bolTerms                String?
  // Invoices: default payment terms in days (0 = due on receipt; null = no due date printed)
  // and notes printed at the bottom of every invoice.
  invoicePaymentTermsDays Int?
  invoiceNotes            String?
  updatedAt               DateTime @updatedAt
  updatedById             String?
}

// ─────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────

model Client {
  id               String       @id @default(cuid())
  companyName      String
  contactName      String?
  email            String?
  phone            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  stateProvince    String?
  postalCode       String?
  country          String?
  mcNumber         String?
  dotNumber        String?
  // Overrides CompanySettings.invoicePaymentTermsDays for this client's invoices.
  paymentTermsDays Int?
  notes            String?
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdById      String?

  contacts ClientContact[]
  loads    Load[]

  @@index([companyName])
  @@index([status])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────
// Carriers & drivers
// ─────────────────────────────────────────────────────────────

model Carrier {
  id                    String       @id @default(cuid())
  legalName             String
  dba                   String?
  mcNumber              String?
  dotNumber             String?
  phone                 String?
  email                 String?
  contactPerson         String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  stateProvince         String?
  postalCode            String?
  country               String?
  insuranceCompany      String?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?    @db.Date
  notes                 String?
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  createdById           String?

  drivers Driver[]
  loads   Load[]

  @@index([legalName])
  @@index([mcNumber])
  @@index([status])
}

model Driver {
  id            String   @id @default(cuid())
  carrierId     String
  firstName     String
  lastName      String?
  phone         String?
  email         String?
  truckNumber   String?
  trailerNumber String?
  licenseNumber String?
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  loads   Load[]

  @@index([carrierId])
}

// ─────────────────────────────────────────────────────────────
// Loads
// ─────────────────────────────────────────────────────────────

model Load {
  id String @id @default(cuid())

  // Human-readable number from a PostgreSQL sequence (starts at 100001, see migration).
  loadNumber Int        @unique @default(autoincrement())
  type       LoadType
  status     LoadStatus @default(CREATED)

  clientId  String
  carrierId String?
  driverId  String?

  // General
  loadDate          DateTime @db.Date
  customerReference String?
  containerNumber   String?
  bookingNumber     String?
  sealNumber        String?

  // Equipment — option lists per load type live in src/features/loads/equipment.ts
  equipmentType String? // e.g. "Dry Container", "Reefer"
  equipmentSize String? // e.g. "40' HC", "53'"
  direction     ShipmentDirection?

  // Cargo
  commodity           String?
  weight              Decimal?   @db.Decimal(12, 2)
  weightUnit          WeightUnit @default(LB)
  pieces              Int?
  specialInstructions String?

  // Pickup (facility-local date/time, never time-zone converted)
  pickupLocationName      String?
  pickupAddressLine1      String?
  pickupAddressLine2      String?
  pickupCity              String?
  pickupStateProvince     String?
  pickupPostalCode        String?
  pickupCountry           String?
  pickupDate              DateTime? @db.Date
  pickupTimeFrom          String? // "HH:mm", facility-local
  pickupTimeTo            String?
  pickupAppointmentNumber String?
  pickupContact           String? // name / phone at the facility
  pickupNotes             String?

  // Delivery
  deliveryLocationName      String?
  deliveryAddressLine1      String?
  deliveryAddressLine2      String?
  deliveryCity              String?
  deliveryStateProvince     String?
  deliveryPostalCode        String?
  deliveryCountry           String?
  deliveryDate              DateTime? @db.Date
  deliveryTimeFrom          String?
  deliveryTimeTo            String?
  deliveryAppointmentNumber String?
  deliveryContact           String?
  deliveryNotes             String?

  // Transportation (truck/trailer are captured per load; defaulted from the driver)
  truckNumber   String?
  trailerNumber String?
  miles         Int?

  // Financial — CONFIDENTIAL. Never passed wholesale to external documents.
  clientRate  Decimal? @db.Decimal(12, 2)
  carrierRate Decimal? @db.Decimal(12, 2)
  currency    Currency @default(USD)

  // Internal only — never mapped to external documents.
  internalNotes String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  client        Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  carrier       Carrier?            @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  driver        Driver?             @relation(fields: [driverId], references: [id], onDelete: Restrict)
  statusHistory LoadStatusHistory[]
  documents     Document[]
  charges       LoadCharge[]

  @@index([containerNumber])
  @@index([createdAt])
  @@index([status])
  @@index([type])
  @@index([pickupDate])
  @@index([deliveryDate])
  @@index([clientId])
  @@index([carrierId])
  @@index([driverId])
}

model LoadStatusHistory {
  id             String      @id @default(cuid())
  loadId         String
  previousStatus LoadStatus?
  newStatus      LoadStatus
  changedById    String?
  notes          String?
  createdAt      DateTime    @default(now())

  load Load @relation(fields: [loadId], references: [id], onDelete: Restrict)

  @@index([loadId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Documents
//
// One row per stored file. Generated documents carry a version number that is
// unique per (load, type); a regeneration creates a new row and never replaces
// an earlier version. Uploaded documents have no version.
// ─────────────────────────────────────────────────────────────

// Extra charges billed to the client on top of the client rate (chassis, detention,
// storage …). CONFIDENTIAL like clientRate: printed only on the client invoice.
model LoadCharge {
  id          String   @id @default(cuid())
  loadId      String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  createdById String?

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
}

model Document {
  id               String         @id @default(cuid())
  loadId           String
  type             DocumentType
  source           DocumentSource
  version          Int?
  // Relative to DOCUMENT_STORAGE_PATH. Always generated server-side.
  storageKey       String         @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String
  notes            String?
  createdAt        DateTime       @default(now())
  createdById      String?
  deletedAt        DateTime?
  deletedById      String?
  deleteReason     String?

  load Load @relation(fields: [loadId], references: [id], onDelete: Restrict)

  @@unique([loadId, type, version])
  @@index([loadId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String // see src/server/audit/audit-actions.ts
  entityType String
  entityId   String
  userId     String?
  // Previous / new values for sensitive changes. Never secrets.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Public website leads
// ─────────────────────────────────────────────────────────────

// QUOTE: full request (email required). CALLBACK: "call me back" — name + phone only.
model QuoteRequest {
  id            String             @id @default(cuid())
  kind          QuoteRequestKind   @default(QUOTE)
  name          String
  company       String?
  phone         String?
  email         String?
  serviceType   String?
  origin        String?
  destination   String?
  /// Equipment the client needs (from the website's fixed list, e.g. "40' container").
  equipment     String?
  loadCount     Int?
  /// When the freight is ready (calendar date, no time zone).
  readyDate     DateTime?          @db.Date
  message       String?
  /// Callback requests: when the client prefers to be called (free text from a fixed list).
  preferredTime String?
  status        QuoteRequestStatus @default(NEW)
  source        LeadSource         @default(WEBSITE)
  createdById   String?
  createdAt     DateTime           @default(now())

  @@index([status, createdAt])
}
