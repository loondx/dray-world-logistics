# ── Application ─────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the site (used for absolute links / cookie security decisions).
APP_URL=http://localhost:3000

# ── Database (self-hosted PostgreSQL) ──────────────────────
POSTGRES_USER=dray
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=dray_world
# Host port for PostgreSQL. Bound to 127.0.0.1 only — never exposed publicly.
POSTGRES_HOST_PORT=5446
# Used by the app and Prisma CLI when running on the host.
# Inside Docker Compose the app overrides the host to "postgres".
DATABASE_URL=postgresql://dray:change-me-to-a-long-random-password@127.0.0.1:5446/dray_world

# Optional direct PostgreSQL connection for migrations (blank uses DATABASE_URL).
# DATABASE_URL_UNPOOLED=
# Vercel: set APP_URL to your HTTPS domain, connect private Blob storage, and
# set STORAGE_DRIVER=blob. Configure these in Vercel, not just this local file.
# RUN_MIGRATIONS=true enables migrations for previews with a separate database.

# ── Sessions ───────────────────────────────────────────────
# Session lifetime in hours (sliding expiry).
SESSION_TTL_HOURS=12

# ── Documents (private storage — NEVER inside /public or the repo) ─
# STORAGE_DRIVER: "local" (folder below; Docker / self-hosting) or "blob" (private Vercel
# Blob store). Defaults to "blob" when BLOB_READ_WRITE_TOKEN is set, else "local".
# STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=
# Absolute path used when the app runs on the host (pnpm dev / tests).
# Inside Docker the app always uses /data/documents (mounted from ${DATA_ROOT}/documents).
# Local development example: /home/<you>/.local/share/dray-world/documents
DOCUMENT_STORAGE_PATH=/data/dray-world/documents
MAX_DOCUMENT_SIZE_MB=20

# ── Docker persistent data root ────────────────────────────
# Contains postgres/, documents/, backups/. Keep it OUTSIDE the repository.
# Local development example: /home/<you>/.local/share/dray-world
DATA_ROOT=/data/dray-world

# ── First admin bootstrap (used ONLY by `pnpm admin:create`) ─
# Leave blank here; pass on the command line or answer the prompts instead.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
